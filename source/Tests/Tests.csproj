<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests for logic that needs no server: dotnet test source\Tests. Not in
       betterSkillys.sln, so building and deploying the servers doesn't need the test packages. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.csproj" />
    <!-- the behaviours, for PortalSourcesTests -->
    <ProjectReference Include="..\WorldServer\WorldServer.csproj" />
  </ItemGroup>

</Project>

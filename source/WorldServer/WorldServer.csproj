<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
	<ImplicitUsings>disable</ImplicitUsings>
	<Nullable>disable</Nullable>
	<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
	<Platforms>AnyCPU;x64</Platforms>
	<!-- optimise the Debug build too: it is the one Run Server.bat builds and runs -->
	<Optimize>true</Optimize>
	<!-- The workstation collector, with full collections in the background beside the world
	     threads. Measured under load (9 bots, 2026-10-24): the server collector (with DATAS or
	     without) stopped every world for 50-420 ms at its gen 0 and gen 1 collections, several times
	     a minute; this one for none over 50 ms in 10 minutes, with 400 MB less memory and less CPU.
	     GcPauseLog logs any pause over 50 ms ("GC pause"), to keep an eye on full collections of the
	     ~1 GB heap (millions of map tiles). -->
	<ServerGarbageCollection>false</ServerGarbageCollection>
	<ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="logic\behaviors\new\modifiers\**" />
    <EmbeddedResource Remove="logic\behaviors\new\modifiers\**" />
    <None Remove="logic\behaviors\new\modifiers\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="wServer.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
